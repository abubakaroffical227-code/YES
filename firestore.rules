      allow delete: if isSignedIn() && isValidId(feedbackId) && (isActiveAdmin() || (resource != null && existing().studentUid == request.auth.uid && !isBlockedUser()));
    }

    // 16. Administrative Audit Logs (Update forbidden; Delete restricted strictly to Super Admin)
    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isActiveAdmin();
      allow list: if isSignedIn() && isActiveAdmin() && existing().societyId == 'YES_UAF';

      allow create: if isSignedIn() && isValidId(logId) &&
        incoming().keys().hasAll(['actorUid', 'actorName', 'actorRole', 'action', 'targetSummary', 'societyId', 'createdAt']) &&
        incoming().keys().hasOnly(['actorUid', 'actorName', 'actorRole', 'action', 'targetSummary', 'societyId', 'createdAt']) &&
        isValidAdminAuditLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        isActiveAdmin();

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(logId) && isSuperAdmin();
    }

    // 17. Blocked Accounts (Admin purges whole student data and blocks login access; blocked user may only read own block notice)
    match /blocked_accounts/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isStudentOrMembershipManager());
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        ((isStudentOrMembershipManager()) && existing().societyId == 'YES_UAF')
      );

      allow create: if isSignedIn() && isValidId(userId) &&
        incoming().keys().hasAll(['userId', 'email', 'fullName', 'reason', 'blockedByUid', 'blockedByName', 'societyId', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'email', 'fullName', 'registrationNumber', 'reason', 'blockedByUid', 'blockedByName', 'societyId', 'createdAt', 'updatedAt']) &&
        isValidBlockedAccount(incoming()) &&
        incoming().userId == userId &&
        (isStudentOrMembershipManager());

      allow update: if isSignedIn() && isValidId(userId) &&
        incoming().keys().hasOnly(['userId', 'email', 'fullName', 'registrationNumber', 'reason', 'blockedByUid', 'blockedByName', 'societyId', 'createdAt', 'updatedAt']) &&
        isValidBlockedAccount(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (isStudentOrMembershipManager());

      allow delete: if isSignedIn() && isValidId(userId) && (isStudentOrMembershipManager());
    }
  }
}
