rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isOptString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    // Bootstrapped Super Administrator (Project Owner with verified email)
    function isBootstrappedSuperAdmin() {
      return isSignedIn() &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true &&
             ('email' in request.auth.token) &&
             request.auth.token.email == 'abubakar.offical227@gmail.com';
    }

    function adminDocExists() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isActiveAdmin() {
      return isBootstrappedSuperAdmin() ||
             (isSignedIn() && adminDocExists() && adminDoc().active == true);
    }

    function isBlockedUser() {
      return exists(/databases/$(database)/documents/blocked_accounts/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isBootstrappedSuperAdmin() ||
             (isSignedIn() && adminDocExists() && adminDoc().active == true &&
              (adminDoc().adminRole == 'SUPER_ADMIN' || 'MANAGE_ADMINS' in adminDoc().permissions));
    }

    function hasAnyRoleOrPerm(roles, permName) {
      return isSuperAdmin() ||
             (isSignedIn() && adminDocExists() && adminDoc().active == true &&
              (adminDoc().adminRole in roles || permName in adminDoc().permissions));
    }

    function isStudentManager() {
      return hasAnyRoleOrPerm(['PRESIDENT', 'CONVENER', 'ADVISORY_BOARD', 'SENIOR_VICE_PRESIDENT', 'ASSOCIATE_SENIOR_VP', 'VICE_PRESIDENT', 'ASSOCIATE_VP', 'GENERAL_SECRETARY', 'ASSOCIATE_GENERAL_SECRETARY', 'JOINT_SECRETARY', 'ASSOCIATE_JOINT_SECRETARY', 'COUNCILLOR', 'ASSOCIATE_COUNCILLOR'], 'MANAGE_STUDENTS');
    }

    function isMembershipManager() {
      return hasAnyRoleOrPerm(['PRESIDENT', 'CONVENER', 'ADVISORY_BOARD', 'SENIOR_VICE_PRESIDENT', 'ASSOCIATE_SENIOR_VP', 'VICE_PRESIDENT', 'ASSOCIATE_VP', 'GENERAL_SECRETARY', 'ASSOCIATE_GENERAL_SECRETARY', 'JOINT_SECRETARY', 'ASSOCIATE_JOINT_SECRETARY', 'COUNCILLOR', 'ASSOCIATE_COUNCILLOR'], 'MANAGE_MEMBERSHIP');
    }

    function isStudentOrMembershipManager() {
      return isSuperAdmin() ||
             (isSignedIn() && adminDocExists() && adminDoc().active == true &&
              (adminDoc().adminRole in ['PRESIDENT', 'CONVENER', 'ADVISORY_BOARD', 'SENIOR_VICE_PRESIDENT', 'ASSOCIATE_SENIOR_VP', 'VICE_PRESIDENT', 'ASSOCIATE_VP', 'GENERAL_SECRETARY', 'ASSOCIATE_GENERAL_SECRETARY', 'JOINT_SECRETARY', 'ASSOCIATE_JOINT_SECRETARY', 'COUNCILLOR', 'ASSOCIATE_COUNCILLOR'] ||
               'MANAGE_STUDENTS' in adminDoc().permissions ||
               'MANAGE_MEMBERSHIP' in adminDoc().permissions));
    }

    function isExecutiveManager() {
      return hasAnyRoleOrPerm(['PRESIDENT', 'CONVENER', 'ADVISORY_BOARD', 'SENIOR_VICE_PRESIDENT', 'VICE_PRESIDENT', 'GENERAL_SECRETARY', 'JOINT_SECRETARY'], 'MANAGE_EXECUTIVE');
    }

    function isEventManager() {
      return hasAnyRoleOrPerm(['PRESIDENT', 'CONVENER', 'ADVISORY_BOARD', 'SENIOR_VICE_PRESIDENT', 'VICE_PRESIDENT', 'GENERAL_SECRETARY', 'JOINT_SECRETARY', 'EVENT_SECRETARY', 'ASSOCIATE_EVENT_SECRETARY', 'SPORTS_SECRETARY', 'ASSOCIATE_SPORTS_SECRETARY', 'COUNCILLOR'], 'MANAGE_EVENTS') ||
             hasAnyRoleOrPerm(['PRESIDENT', 'CONVENER', 'EVENT_SECRETARY', 'ASSOCIATE_EVENT_SECRETARY'], 'MANAGE_REGISTRATIONS');
    }

    function isFinanceAdmin() {
      return hasAnyRoleOrPerm(['PRESIDENT', 'FINANCE_SECRETARY', 'ASSOCIATE_FINANCE_SECRETARY'], 'MANAGE_FINANCE');
    }

    function isEventOrFinanceAdmin() {
      return isEventManager() || isFinanceAdmin();
    }

    function isAttendanceManager() {
      return hasAnyRoleOrPerm(['PRESIDENT', 'CONVENER', 'ATTENDANCE_MANAGER', 'ASSOCIATE_EVENT_SECRETARY', 'ASSOCIATE_COUNCILLOR'], 'MANAGE_ATTENDANCE') || isEventManager();
    }

    function isAnnouncementManager() {
      return hasAnyRoleOrPerm(['PRESIDENT', 'CONVENER', 'ADVISORY_BOARD', 'INFORMATION_SECRETARY', 'ASSOCIATE_INFORMATION_SECRETARY', 'PRESS_SECRETARY', 'ASSOCIATE_PRESS_SECRETARY', 'IT_MEDIA_CELL', 'ASSOCIATE_IT_MEDIA_CELL', 'GENERAL_SECRETARY', 'ASSOCIATE_GENERAL_SECRETARY', 'JOINT_SECRETARY'], 'MANAGE_ANNOUNCEMENTS') ||
             isEventManager();
    }

    function isGalleryManager() {
      return hasAnyRoleOrPerm(['PRESIDENT', 'INFORMATION_SECRETARY', 'ASSOCIATE_INFORMATION_SECRETARY', 'PRESS_SECRETARY', 'ASSOCIATE_PRESS_SECRETARY', 'IT_MEDIA_CELL', 'ASSOCIATE_IT_MEDIA_CELL'], 'MANAGE_GALLERY');
    }

    function isCertificateManager() {
      return hasAnyRoleOrPerm(['PRESIDENT', 'CONVENER', 'ADVISORY_BOARD', 'SENIOR_VICE_PRESIDENT', 'VICE_PRESIDENT', 'GENERAL_SECRETARY', 'JOINT_SECRETARY', 'IT_MEDIA_CELL'], 'MANAGE_CERTIFICATES') || isEventManager();
    }

    // --- Validation Helpers ---

    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             isOptString(data, 'photoUri', 500000) &&
             data.accountType in ['STUDENT', 'ADMIN'] &&
             data.active is bool &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStudentProfile(data) {
      return data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 40 &&
             isOptString(data, 'degreeLevel', 80) &&
             data.department is string && data.department.size() >= 2 && data.department.size() <= 100 &&
             data.semester is string && data.semester.size() >= 1 && data.semester.size() <= 40 &&
             isOptString(data, 'phone', 30) &&
             isOptString(data, 'photoUri', 500000) &&
             isOptString(data, 'studentCardUri', 500000) &&
             isOptString(data, 'position', 80) &&
             (!('profileLocked' in data) || data.profileLocked == null || data.profileLocked is bool) &&
             data.membershipStatus in ['NONE', 'PENDING', 'ACTIVE', 'VERIFIED', 'INACTIVE', 'REJECTED'] &&
             (!('idCardStatus' in data) || data.idCardStatus == null || data.idCardStatus in ['', 'NOT_ISSUED', 'ISSUED', 'REVOKED']) &&
             isOptString(data, 'membershipId', 50) &&
             isOptString(data, 'membershipValidUntil', 40) &&
             data.active is bool &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAdminAccount(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.adminRole in [
               'SUPER_ADMIN', 'PRESIDENT',
               'CONVENER', 'ADVISORY_BOARD',
               'SENIOR_VICE_PRESIDENT', 'ASSOCIATE_SENIOR_VP',
               'VICE_PRESIDENT', 'ASSOCIATE_VP',
               'GENERAL_SECRETARY', 'ASSOCIATE_GENERAL_SECRETARY',
               'JOINT_SECRETARY', 'ASSOCIATE_JOINT_SECRETARY',
               'COUNCILLOR', 'ASSOCIATE_COUNCILLOR',
               'FINANCE_SECRETARY', 'ASSOCIATE_FINANCE_SECRETARY',
               'IT_MEDIA_CELL', 'ASSOCIATE_IT_MEDIA_CELL',
               'PRESS_SECRETARY', 'ASSOCIATE_PRESS_SECRETARY',
               'INFORMATION_SECRETARY', 'ASSOCIATE_INFORMATION_SECRETARY',
               'EVENT_SECRETARY', 'ASSOCIATE_EVENT_SECRETARY',
               'SPORTS_SECRETARY', 'ASSOCIATE_SPORTS_SECRETARY',
               'ATTENDANCE_MANAGER'
             ] &&
             data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 80 &&
             data.permissions is list && data.permissions.size() <= 15 &&
             (data.permissions.size() == 0 || (data.permissions[0] is string && data.permissions[0].size() <= 50)) &&
             data.active is bool &&
             data.assignedByUid is string && data.assignedByUid.size() >= 1 && data.assignedByUid.size() <= 128 &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMembershipApplication(data) {
      return data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 100 &&
             data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 150 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 40 &&
             isOptString(data, 'degreeLevel', 80) &&
             data.department is string && data.department.size() >= 2 && data.department.size() <= 100 &&
             data.semester is string && data.semester.size() >= 1 && data.semester.size() <= 40 &&
             isOptString(data, 'phone', 30) &&
             isOptString(data, 'photoUri', 500000) &&
             isOptString(data, 'studentCardUri', 500000) &&
             data.motivation is string && data.motivation.size() >= 3 && data.motivation.size() <= 600 &&
             data.status in ['PENDING', 'APPROVED', 'VERIFIED', 'REJECTED'] &&
             isOptString(data, 'assignedMembershipId', 50) &&
             isOptString(data, 'reviewedByUid', 128) &&
             isOptString(data, 'reviewNotes', 300) &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidExecutiveMember(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 80 &&
             data.department is string && data.department.size() >= 2 && data.department.size() <= 100 &&
             data.tenure is string && data.tenure.size() >= 2 && data.tenure.size() <= 40 &&
             isOptString(data, 'email', 150) &&
             isOptString(data, 'photoUri', 500000) &&
             data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 1000 &&
             data.published is bool &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSocietyEvent(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 3 && data.description.size() <= 1500 &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
             data.eventDate is string && data.eventDate.size() >= 4 && data.eventDate.size() <= 40 &&
             data.eventTime is string && data.eventTime.size() >= 2 && data.eventTime.size() <= 40 &&
             data.venue is string && data.venue.size() >= 2 && data.venue.size() <= 150 &&
             isOptString(data, 'posterUri', 500000) &&
             data.registrationDeadline is string && data.registrationDeadline.size() >= 4 && data.registrationDeadline.size() <= 40 &&
             data.registrationFee is number && data.registrationFee >= 0 && data.registrationFee <= 1000000 &&
             data.maxParticipants is int && data.maxParticipants >= 1 && data.maxParticipants <= 100000 &&
             data.registeredCount is int && data.registeredCount >= 0 && data.registeredCount <= data.maxParticipants &&
             data.qrCodeToken is string && data.qrCodeToken.size() >= 4 && data.qrCodeToken.size() <= 100 &&
             data.upcoming is bool &&
             data.published is bool &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidEventRegistration(data) {
      return data.eventId is string && isValidId(data.eventId) &&
             data.eventTitle is string && data.eventTitle.size() >= 2 && data.eventTitle.size() <= 120 &&
             data.eventDate is string && data.eventDate.size() >= 4 && data.eventDate.size() <= 40 &&
             data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 100 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 40 &&
             data.department is string && data.department.size() >= 2 && data.department.size() <= 100 &&
             data.feeAmount is number && data.feeAmount >= 0 && data.feeAmount <= 1000000 &&
             data.paymentStatus in ['FREE', 'UNPAID', 'RECEIPT_SUBMITTED', 'PAID', 'REJECTED'] &&
             data.registrationStatus in ['PENDING', 'APPROVED', 'REJECTED'] &&
             isOptString(data, 'receiptUri', 500000) &&
             isOptString(data, 'transactionRef', 100) &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAttendanceRecord(data) {
      return data.eventId is string && isValidId(data.eventId) &&
             data.eventTitle is string && data.eventTitle.size() >= 2 && data.eventTitle.size() <= 120 &&
             data.eventDate is string && data.eventDate.size() >= 4 && data.eventDate.size() <= 40 &&
             data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 100 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 40 &&
             isOptString(data, 'membershipId', 50) &&
             data.status in ['PRESENT', 'ABSENT', 'EXCUSED'] &&
             data.method in ['MANUAL', 'QR_SCAN', 'EVENT_QR_CHECKIN'] &&
             data.markedByUid is string && data.markedByUid.size() >= 1 && data.markedByUid.size() <= 128 &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
             data.message is string && data.message.size() >= 3 && data.message.size() <= 2000 &&
             data.category in ['GENERAL', 'MEETING', 'DEADLINE', 'URGENT', 'EVENT_REMINDER'] &&
             data.targetGroup in ['ALL_STUDENTS', 'ACTIVE_MEMBERS', 'EXECUTIVE_BODY'] &&
             data.priority in ['NORMAL', 'IMPORTANT', 'URGENT'] &&
             isOptString(data, 'scheduledDate', 40) &&
             data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100 &&
             data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
             data.published is bool &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidUserNotification(data) {
      return data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
             data.body is string && data.body.size() >= 2 && data.body.size() <= 600 &&
             data.type in ['ANNOUNCEMENT', 'EVENT', 'DEADLINE', 'MEMBERSHIP', 'PAYMENT', 'SCHEDULE', 'CERTIFICATE'] &&
             data.read is bool &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStudentPayment(data) {
      return data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 100 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 40 &&
             isOptString(data, 'eventId', 128) &&
             data.purposeTitle is string && data.purposeTitle.size() >= 2 && data.purposeTitle.size() <= 150 &&
             data.amount is number && data.amount >= 0 && data.amount <= 1000000 &&
             isOptString(data, 'paymentDate', 40) &&
             isOptString(data, 'transactionRef', 100) &&
             isOptString(data, 'receiptUri', 500000) &&
             data.status in ['UNPAID', 'PENDING_VERIFICATION', 'VERIFIED', 'REJECTED'] &&
             isOptString(data, 'verifiedByUid', 128) &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFinanceTransaction(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
             data.type in ['INCOME', 'EXPENSE'] &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
             data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
             data.transactionDate is string && data.transactionDate.size() >= 4 && data.transactionDate.size() <= 40 &&
             isOptString(data, 'referenceNumber', 100) &&
             isOptString(data, 'relatedEventId', 128) &&
             isOptString(data, 'notes', 500) &&
             data.recordedByUid is string && data.recordedByUid.size() >= 1 && data.recordedByUid.size() <= 128 &&
             data.recordedByName is string && data.recordedByName.size() >= 2 && data.recordedByName.size() <= 100 &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPaymentAccount(data) {
      return data.accountType in ['Bank Account', 'JazzCash', 'EasyPaisa', 'SadaPay', 'Nayapay', 'Other'] &&
             data.bankOrWalletName is string && data.bankOrWalletName.size() >= 2 && data.bankOrWalletName.size() <= 100 &&
             data.accountTitle is string && data.accountTitle.size() >= 2 && data.accountTitle.size() <= 120 &&
             data.accountNumber is string && data.accountNumber.size() >= 3 && data.accountNumber.size() <= 80 &&
             isOptString(data, 'ibanOrBranch', 120) &&
             isOptString(data, 'instructions', 500) &&
             data.active is bool &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidGalleryItem(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.albumCategory is string && data.albumCategory.size() >= 2 && data.albumCategory.size() <= 60 &&
             isOptString(data, 'caption', 400) &&
             data.eventDate is string && data.eventDate.size() >= 4 && data.eventDate.size() <= 40 &&
             isOptString(data, 'imageUri', 500000) &&
             isOptString(data, 'accentTheme', 40) &&
             data.approved is bool &&
             data.uploadedByUid is string && data.uploadedByUid.size() >= 1 && data.uploadedByUid.size() <= 128 &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSocietyCertificate(data) {
      return data.certificateCode is string && data.certificateCode.size() >= 4 && data.certificateCode.size() <= 60 &&
             data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 100 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 40 &&
             isOptString(data, 'eventId', 128) &&
             data.eventTitle is string && data.eventTitle.size() >= 2 && data.eventTitle.size() <= 120 &&
             data.eventDate is string && data.eventDate.size() >= 4 && data.eventDate.size() <= 40 &&
             data.certificateType in ['PARTICIPATION', 'ORGANIZER', 'MERIT', 'MEMBERSHIP'] &&
             data.authorizedSignatory is string && data.authorizedSignatory.size() >= 2 && data.authorizedSignatory.size() <= 120 &&
             data.issuedByUid is string && data.issuedByUid.size() >= 1 && data.issuedByUid.size() <= 128 &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStudentFeedback(data) {
      return data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 100 &&
             data.category in ['SUGGESTION', 'COMPLAINT', 'EVENT_FEEDBACK', 'GENERAL_MESSAGE'] &&
             data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 150 &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 1500 &&
             isOptString(data, 'relatedEventTitle', 120) &&
             data.status in ['SUBMITTED', 'IN_REVIEW', 'RESOLVED'] &&
             isOptString(data, 'adminResponse', 1000) &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAdminAuditLog(data) {
      return data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
             data.actorName is string && data.actorName.size() >= 2 && data.actorName.size() <= 100 &&
             data.actorRole is string && data.actorRole.size() >= 2 && data.actorRole.size() <= 50 &&
             data.action is string && data.action.size() >= 2 && data.action.size() <= 120 &&
             data.targetSummary is string && data.targetSummary.size() >= 2 && data.targetSummary.size() <= 300 &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt);
    }

    function isValidBlockedAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             isOptString(data, 'registrationNumber', 40) &&
             data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 400 &&
             data.blockedByUid is string && data.blockedByUid.size() >= 1 && data.blockedByUid.size() <= 128 &&
             data.blockedByName is string && data.blockedByName.size() >= 2 && data.blockedByName.size() <= 100 &&
             data.societyId == 'YES_UAF' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- Collection Rules ---

    // 1. Users Collection (PII isolated to owner or active admin; students cannot self-assign ADMIN; blocked accounts denied)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && ((request.auth.uid == userId && !isBlockedUser()) || isActiveAdmin());
      allow list: if isSignedIn() && (
        (existing().userId == request.auth.uid && !isBlockedUser()) ||
        (isActiveAdmin() && existing().societyId == 'YES_UAF')
      );

      allow create: if isSignedIn() && isValidId(userId) &&
        incoming().keys().hasAll(['userId', 'email', 'fullName', 'accountType', 'active', 'societyId', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'email', 'fullName', 'photoUri', 'accountType', 'active', 'societyId', 'createdAt', 'updatedAt']) &&
        isValidUserAccount(incoming()) &&
        incoming().userId == userId &&
        (
          (request.auth.uid == userId && !isBlockedUser() && incoming().accountType == 'STUDENT' && incoming().active == true) ||
          isSuperAdmin()
        );

      allow update: if isSignedIn() && isValidId(userId) && isValidUserAccount(incoming()) &&
