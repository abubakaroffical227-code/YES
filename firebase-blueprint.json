{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Core user identity and role routing record for Young Entomologist Society.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the user." },
        "email": { "type": "string", "format": "email", "description": "Verified email address." },
        "fullName": { "type": "string", "description": "Full display name." },
        "photoUri": { "type": "string", "description": "Optional profile image URI." },
        "accountType": { "type": "string", "enum": ["STUDENT", "ADMIN"], "description": "Assigned role category." },
        "active": { "type": "boolean", "description": "Whether the account is active." },
        "societyId": { "type": "string", "description": "Society tenant identifier YES_UAF." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "email", "fullName", "accountType", "active", "societyId", "createdAt", "updatedAt"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "University student profile and society membership record.",
      "type": "object",
      "properties": {
        "studentUid": { "type": "string", "description": "UID or admin-created student identifier." },
        "fullName": { "type": "string", "description": "Student full name." },
        "email": { "type": "string", "format": "email", "description": "Student email address." },
        "registrationNumber": { "type": "string", "description": "University registration number (e.g. 2023-ag-4512)." },
        "degreeLevel": { "type": "string", "description": "Academic degree level (e.g. BSc (Hons) Agriculture, MS / MPhil, PhD)." },
        "department": { "type": "string", "description": "Academic department." },
        "semester": { "type": "string", "description": "Current semester." },
        "phone": { "type": "string", "description": "Contact phone number." },
        "photoUri": { "type": "string", "description": "Profile photograph URI or Base64 data URL." },
        "studentCardUri": { "type": "string", "description": "Uploaded university student card image URI or Base64 data URL." },
        "position": { "type": "string", "description": "Assigned society position or designation on ID card." },
        "profileLocked": { "type": "boolean", "description": "True once approved by administrator; only administrator can unlock." },
        "membershipStatus": { "type": "string", "enum": ["NONE", "PENDING", "ACTIVE", "VERIFIED", "INACTIVE", "REJECTED"] },
        "idCardStatus": { "type": "string", "enum": ["", "NOT_ISSUED", "ISSUED", "REVOKED"], "description": "Administrative issuance state of the student's YES ID card." },
        "membershipId": { "type": "string", "description": "Assigned YES membership card ID." },
        "membershipValidUntil": { "type": "string", "description": "Membership validity date." },
        "active": { "type": "boolean", "description": "Whether student account is active." },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "FieldValue.serverTimestamp()" }
      },
      "required": ["studentUid", "fullName", "email", "registrationNumber", "department", "semester", "membershipStatus", "active", "societyId", "createdAt", "updatedAt"]
    },
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Administrator role assignment and granular permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "adminRole": {
          "type": "string",
          "enum": [
            "SUPER_ADMIN",
            "PRESIDENT",
            "CONVENER",
            "ADVISORY_BOARD",
            "SENIOR_VICE_PRESIDENT",
            "ASSOCIATE_SENIOR_VP",
            "VICE_PRESIDENT",
            "ASSOCIATE_VP",
            "GENERAL_SECRETARY",
            "ASSOCIATE_GENERAL_SECRETARY",
            "JOINT_SECRETARY",
            "ASSOCIATE_JOINT_SECRETARY",
            "COUNCILLOR",
            "ASSOCIATE_COUNCILLOR",
            "FINANCE_SECRETARY",
            "ASSOCIATE_FINANCE_SECRETARY",
            "IT_MEDIA_CELL",
            "ASSOCIATE_IT_MEDIA_CELL",
            "PRESS_SECRETARY",
            "ASSOCIATE_PRESS_SECRETARY",
            "INFORMATION_SECRETARY",
            "ASSOCIATE_INFORMATION_SECRETARY",
            "EVENT_SECRETARY",
            "ASSOCIATE_EVENT_SECRETARY",
            "SPORTS_SECRETARY",
            "ASSOCIATE_SPORTS_SECRETARY",
            "ATTENDANCE_MANAGER"
          ]
        },
        "designation": { "type": "string" },
        "permissions": { "type": "array", "description": "Bounded list of permission flags." },
        "active": { "type": "boolean" },
        "assignedByUid": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "adminRole", "designation", "permissions", "active", "assignedByUid", "societyId", "createdAt", "updatedAt"]
    },
    "MembershipApplication": {
      "title": "MembershipApplication",
      "description": "Student society membership application.",
      "type": "object",
      "properties": {
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "degreeLevel": { "type": "string" },
        "department": { "type": "string" },
        "semester": { "type": "string" },
        "phone": { "type": "string" },
        "photoUri": { "type": "string" },
        "studentCardUri": { "type": "string" },
        "motivation": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "VERIFIED", "REJECTED"] },
        "assignedMembershipId": { "type": "string" },
        "reviewedByUid": { "type": "string" },
        "reviewNotes": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentUid", "studentName", "studentEmail", "registrationNumber", "department", "semester", "motivation", "status", "societyId", "createdAt", "updatedAt"]
    },
    "ExecutiveMember": {
      "title": "ExecutiveMember",
      "description": "Office bearer in the Young Entomologist Society executive body.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "designation": { "type": "string" },
        "department": { "type": "string" },
        "tenure": { "type": "string" },
        "email": { "type": "string" },
        "photoUri": { "type": "string" },
        "displayOrder": { "type": "integer" },
        "published": { "type": "boolean" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "designation", "department", "tenure", "displayOrder", "published", "societyId", "createdAt", "updatedAt"]
    },
    "SocietyEvent": {
      "title": "SocietyEvent",
      "description": "University society event, seminar, workshop, gala, or study tour.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "eventDate": { "type": "string" },
        "eventTime": { "type": "string" },
        "venue": { "type": "string" },
        "posterUri": { "type": "string" },
        "registrationDeadline": { "type": "string" },
        "registrationFee": { "type": "number" },
        "maxParticipants": { "type": "integer" },
        "registeredCount": { "type": "integer" },
        "qrCodeToken": { "type": "string" },
        "upcoming": { "type": "boolean" },
        "published": { "type": "boolean" },
        "createdByUid": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "category", "eventDate", "eventTime", "venue", "registrationDeadline", "registrationFee", "maxParticipants", "registeredCount", "qrCodeToken", "upcoming", "published", "createdByUid", "societyId", "createdAt", "updatedAt"]
    },
    "EventRegistration": {
      "title": "EventRegistration",
      "description": "Student registration for a society event.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "eventDate": { "type": "string" },
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "department": { "type": "string" },
        "feeAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["FREE", "UNPAID", "RECEIPT_SUBMITTED", "PAID", "REJECTED"] },
        "registrationStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "receiptUri": { "type": "string" },
        "transactionRef": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "eventTitle", "eventDate", "studentUid", "studentName", "registrationNumber", "department", "feeAmount", "paymentStatus", "registrationStatus", "societyId", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Manual or QR-scanned attendance record for an event.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "eventDate": { "type": "string" },
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "membershipId": { "type": "string" },
        "status": { "type": "string", "enum": ["PRESENT", "ABSENT", "EXCUSED"] },
        "method": { "type": "string", "enum": ["MANUAL", "QR_SCAN", "EVENT_QR_CHECKIN"] },
        "markedByUid": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "eventTitle", "eventDate", "studentUid", "studentName", "registrationNumber", "status", "method", "markedByUid", "societyId", "createdAt", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Society announcement, schedule update, or urgent notice.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string", "enum": ["GENERAL", "MEETING", "DEADLINE", "URGENT", "EVENT_REMINDER"] },
        "targetGroup": { "type": "string", "enum": ["ALL_STUDENTS", "ACTIVE_MEMBERS", "EXECUTIVE_BODY"] },
        "priority": { "type": "string", "enum": ["NORMAL", "IMPORTANT", "URGENT"] },
        "scheduledDate": { "type": "string" },
        "authorName": { "type": "string" },
        "authorUid": { "type": "string" },
        "published": { "type": "boolean" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "category", "targetGroup", "priority", "authorName", "authorUid", "published", "societyId", "createdAt", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Personal student notification.",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["ANNOUNCEMENT", "EVENT", "DEADLINE", "MEMBERSHIP", "PAYMENT", "SCHEDULE", "CERTIFICATE"] },
        "read": { "type": "boolean" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "title", "body", "type", "read", "societyId", "createdAt", "updatedAt"]
    },
    "StudentPayment": {
      "title": "StudentPayment",
      "description": "Student fee payment and receipt verification record.",
      "type": "object",
      "properties": {
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "eventId": { "type": "string" },
        "purposeTitle": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string" },
        "transactionRef": { "type": "string" },
        "receiptUri": { "type": "string" },
        "status": { "type": "string", "enum": ["UNPAID", "PENDING_VERIFICATION", "VERIFIED", "REJECTED"] },
        "verifiedByUid": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentUid", "studentName", "registrationNumber", "purposeTitle", "amount", "status", "societyId", "createdAt", "updatedAt"]
    },
    "FinanceTransaction": {
      "title": "FinanceTransaction",
      "description": "Society income and expense ledger entry restricted to Finance Admins.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["INCOME", "EXPENSE"] },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "transactionDate": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "relatedEventId": { "type": "string" },
        "notes": { "type": "string" },
        "recordedByUid": { "type": "string" },
        "recordedByName": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "category", "amount", "transactionDate", "recordedByUid", "recordedByName", "societyId", "createdAt", "updatedAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Society gallery album photograph.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "albumCategory": { "type": "string" },
        "caption": { "type": "string" },
        "eventDate": { "type": "string" },
        "imageUri": { "type": "string" },
        "accentTheme": { "type": "string" },
        "approved": { "type": "boolean" },
        "uploadedByUid": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "albumCategory", "eventDate", "approved", "uploadedByUid", "societyId", "createdAt", "updatedAt"]
    },
    "SocietyCertificate": {
      "title": "SocietyCertificate",
      "description": "Participation or merit certificate issued to a student.",
      "type": "object",
      "properties": {
        "certificateCode": { "type": "string" },
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "eventDate": { "type": "string" },
        "certificateType": { "type": "string", "enum": ["PARTICIPATION", "ORGANIZER", "MERIT", "MEMBERSHIP"] },
        "authorizedSignatory": { "type": "string" },
        "issuedByUid": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["certificateCode", "studentUid", "studentName", "registrationNumber", "eventTitle", "eventDate", "certificateType", "authorizedSignatory", "issuedByUid", "societyId", "createdAt", "updatedAt"]
    },
    "StudentFeedback": {
      "title": "StudentFeedback",
      "description": "Student suggestion, complaint, or event feedback submission.",
      "type": "object",
      "properties": {
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "category": { "type": "string", "enum": ["SUGGESTION", "COMPLAINT", "EVENT_FEEDBACK", "GENERAL_MESSAGE"] },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "relatedEventTitle": { "type": "string" },
        "status": { "type": "string", "enum": ["SUBMITTED", "IN_REVIEW", "RESOLVED"] },
        "adminResponse": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentUid", "studentName", "category", "subject", "message", "status", "societyId", "createdAt", "updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable administrative activity audit trail.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string" },
        "targetSummary": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorName", "actorRole", "action", "targetSummary", "societyId", "createdAt"]
    },
    "PaymentAccount": {
      "title": "PaymentAccount",
      "description": "Official society bank or mobile wallet receiving account configured by Finance Administrator.",
      "type": "object",
      "properties": {
        "accountType": { "type": "string", "enum": ["Bank Account", "JazzCash", "EasyPaisa", "SadaPay", "Nayapay", "Other"] },
        "bankOrWalletName": { "type": "string" },
        "accountTitle": { "type": "string" },
        "accountNumber": { "type": "string" },
        "ibanOrBranch": { "type": "string" },
        "instructions": { "type": "string" },
        "active": { "type": "boolean" },
        "updatedByUid": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["accountType", "bankOrWalletName", "accountTitle", "accountNumber", "active", "updatedByUid", "societyId", "createdAt", "updatedAt"]
    },
    "BlockedAccount": {
      "title": "BlockedAccount",
      "description": "Blocked student account record preventing login access and re-registration after administrative purge or ban.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "reason": { "type": "string" },
        "blockedByUid": { "type": "string" },
        "blockedByName": { "type": "string" },
        "societyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "fullName", "reason", "blockedByUid", "blockedByName", "societyId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "UserAccount", "description": "User accounts and role routing." },
    "/students/{studentId}": { "schema": "StudentProfile", "description": "Student profiles and society membership cards." },
    "/admins/{adminId}": { "schema": "AdminAccount", "description": "Administrator accounts and granular permissions." },
    "/membership_applications/{applicationId}": { "schema": "MembershipApplication", "description": "Student membership applications." },
    "/executive_body/{memberId}": { "schema": "ExecutiveMember", "description": "Executive body office bearers." },
    "/events/{eventId}": { "schema": "SocietyEvent", "description": "Society events and schedules." },
    "/event_registrations/{registrationId}": { "schema": "EventRegistration", "description": "Student event registrations." },
    "/attendance_records/{attendanceId}": { "schema": "AttendanceRecord", "description": "Event attendance records." },
    "/announcements/{announcementId}": { "schema": "Announcement", "description": "Society announcements and notices." },
    "/notifications/{notificationId}": { "schema": "UserNotification", "description": "Personal student notifications." },
    "/payments/{paymentId}": { "schema": "StudentPayment", "description": "Student fee payment records." },
    "/finance_transactions/{transactionId}": { "schema": "FinanceTransaction", "description": "Society income and expense ledger." },
    "/payment_accounts/{accountId}": { "schema": "PaymentAccount", "description": "Official society payment receiving accounts." },
    "/gallery_items/{itemId}": { "schema": "GalleryItem", "description": "Society gallery photographs." },
    "/certificates/{certificateId}": { "schema": "SocietyCertificate", "description": "Participation and merit certificates." },
    "/feedback/{feedbackId}": { "schema": "StudentFeedback", "description": "Student suggestions and complaints." },
    "/audit_logs/{logId}": { "schema": "AdminAuditLog", "description": "Immutable administrative activity logs." },
    "/blocked_accounts/{userId}": { "schema": "BlockedAccount", "description": "Blocked student accounts barred from login access." }
  }
}
